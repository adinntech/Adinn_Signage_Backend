        "typecheck": "tsc -p tsconfig.check.json",
        "test": "vitest run",
        "seed": "tsx src/scripts/seed.ts",
        "create-user": "tsx src/scripts/create-user.ts",
        "reset-mpin": "tsx src/scripts/reset-mpin.ts",
        "zoho:token": "tsx src/scripts/zoho-refresh-token.ts",
        "migrate:sales-arrays": "tsx src/scripts/migrate-sales-arrays.ts",
        "migrate:file-assets": "tsx src/scripts/migrate-file-assets.ts",
        "seed:industries": "tsx src/scripts/seed-industries.ts",
        "format": "prettier --write src tests",
        "e2e:server": "tsx scripts/e2e-server.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1152.0",
