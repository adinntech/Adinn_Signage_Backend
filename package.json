        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.3.0",
        "@types/node": "^26.6.4",
        "@types/nodemailer": "^8.0.2",
