        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^18.0.6",
        "exceljs": "^4.4.0",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.11.1",
        "morgan": "^1.12.1",
        "multer": "^2.4.0",
        "nodemailer": "^10.1.7",
        "web-push": "^3.6.7",
        "pdfkit": "^0.17.2",
        "zod": "^4.6.5"
