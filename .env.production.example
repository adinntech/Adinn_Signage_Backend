# LIVE. Non-secret settings only; secrets come from .env or the host dashboard (Render etc.).
# Fill the two REPLACE values with the real hostnames before deploying. The server refuses to start while they remain.
# The host must also set NODE_ENV=production so this file is picked up.
PORT=4000
PUBLIC_BASE_URL=https://REPLACE-WITH-LIVE-API-HOST
CORS_ORIGINS=https://REPLACE-WITH-LIVE-WEB-HOST
COOKIE_SECURE=true


# Files go to DigitalOcean Spaces under the signage/ folder of the shared bucket.
STORAGE_TYPE=space
STORAGE_PREFIX=signage
MAX_FILE_SIZE=52428800
MAX_IMAGE_SIZE=3145728
MAX_VIDEO_SIZE=10485760
SIGNED_URL_TTL_SECONDS=600


# Link target used inside notification emails. Replace with the live web CRM address.
WEB_BASE_URL=https://REPLACE-WITH-LIVE-WEB-HOST
# Map services for shop allocation (open services, no key). Leave as is, or point to your own server.
ROUTING_URL=https://router.project-osrm.org
GEOCODER_URL=https://nominatim.openstreetmap.org
MAPS_USER_AGENT=AdinnSignageRecceCRM/1.0 (ops@your-company.example)
# Optional: a Google Maps Platform key (Geocoding API + Routes API). Leave empty to use the open services above.
GOOGLE_MAPS_API_KEY=
GOOGLE_TRAVEL_MODE=TWO_WHEELER

# Read notifications are deleted after this many days (0 = keep forever); unread are never deleted
NOTIFICATION_READ_RETENTION_DAYS=7
NOTIFICATION_CLEANUP_INTERVAL_HOURS=6

# public-read = anyone with the file URL can open it; private = only signed links from the CRM
DO_SPACES_ACL=public-read

# Erase stored files that no project records (0 = off). Grace = never touch files newer than this many minutes
STORAGE_ORPHAN_CLEANUP_HOURS=0
STORAGE_ORPHAN_GRACE_MINUTES=60

STORAGE_ORPHAN_WATCH=false
