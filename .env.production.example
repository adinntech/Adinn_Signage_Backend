# LIVE. Non-secret settings only; secrets come from .env or the host dashboard (Render etc.).
# Fill the two REPLACE values with the real hostnames before deploying. The server refuses to start while they remain.
# The host must also set NODE_ENV=production so this file is picked up.
PORT=4000
PUBLIC_BASE_URL=https://REPLACE-WITH-LIVE-API-HOST
CORS_ORIGINS=https://REPLACE-WITH-LIVE-WEB-HOST
COOKIE_SECURE=true


# Files go to DigitalOcean Spaces under the signage/ folder of the shared bucket.
STORAGE_TYPE=space
STORAGE_PREFIX=signage
MAX_FILE_SIZE=52428800
MAX_IMAGE_SIZE=3145728
MAX_VIDEO_SIZE=10485760
SIGNED_URL_TTL_SECONDS=600


# Link target used inside notification emails. Replace with the live web CRM address.
WEB_BASE_URL=https://REPLACE-WITH-LIVE-WEB-HOST



