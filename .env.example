# Shared SECRETS. Copy to .env and fill in. Never commit real values.
NODE_ENV=development
# MongoDB connection string (Atlas or local).
MONGODB_URI=mongodb+srv://adinntechnology_db_user:Adinntech%40123@designtask.jzzt6kr.mongodb.net/?appName=Adinn_Signage
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# If you see "querySrv ECONNREFUSED", your system DNS blocks SRV lookups. The API retries with these servers automatically.
DNS_SERVERS=8.8.8.8,1.1.1.1
# Used only by `npm run seed`
SEED_ADMIN_EMAIL=admin@adinn.local
SEED_ADMIN_MPIN=


# DigitalOcean Spaces (needed when STORAGE_TYPE=space; leave empty for local storage)
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_REGION=sgp1
DO_SPACES_CDN_BASE=
DO_SPACES_KEY=
DO_SPACES_SECRET=


# Per-environment (non-secret) settings live in .env.development / .env.production. See the *.example files.


# Email notifications (optional). Leave SMTP_HOST empty to keep notifications in-app only; email deliveries are then
# recorded as "not sent" in the database instead of being faked. Works with any SMTP server (Zoho, Office 365, Gmail app password...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ADINN Recce CRM <noreply@your-domain.example>"

# PHP mail service for client emails (Customer Onboarding Form). JSON is POSTed to this URL with the PDF as a link.
# Leave empty until the URL is available: emails are then recorded as "not sent". PHP_MAIL_KEY is optional (X-Api-Key header).
PHP_MAIL_URL=
PHP_MAIL_KEY=

# Signage code-request mail (Client / Project / Combined) via the PHP API on cPanel. Key must match SIGNAGE_API_KEY in config.local.php there.
SIGNAGE_MAIL_URL=https://adinndigital.com/api/signage_emails/signage_email_api/index_signage.php
SIGNAGE_MAIL_KEY=
# Most MB of attachments per vendor mail sent to the PHP API (default 12). Lower it if the web server in front of the PHP API refuses big requests (HTTP 413).
SIGNAGE_MAIL_MAX_TOTAL_MB=12
# Project code request email (Recce Assign). Leave both empty to reuse SIGNAGE_MAIL_URL / SIGNAGE_MAIL_KEY above (same PHP API, mailtype "project").
SIGNAGE_MAIL_API_URL=
SIGNAGE_MAIL_API_KEY=

# Zoho: existing client list for Order Management / Lead Management. Leave the three keys empty to use a sample list.
# ZOHO_PRODUCT is books (Zoho Books contacts, needs ZOHO_ORG_ID) or crm (Zoho CRM Accounts). ZOHO_DC: in, com, eu ...
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_PRODUCT=books
ZOHO_DC=in
ZOHO_ORG_ID=

# Browser push notifications (Chrome / Edge / Firefox, even when the CRM tab is closed).
# Generate once with: npx web-push generate-vapid-keys   and use the SAME pair locally and live.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.example

# Read notifications are deleted after this many days (0 = keep forever); unread are never deleted
NOTIFICATION_READ_RETENTION_DAYS=7
NOTIFICATION_CLEANUP_INTERVAL_HOURS=6

# public-read = anyone with the file URL can open it; private = only signed links from the CRM
DO_SPACES_ACL=public-read

# Erase stored files that no project records (0 = off). Grace = never touch files newer than this many minutes
STORAGE_ORPHAN_CLEANUP_HOURS=0
STORAGE_ORPHAN_GRACE_MINUTES=60

# Upload size limits in bytes (the web app reads these; nothing is hard-coded)
MAX_FILE_SIZE=52428800
MAX_IMAGE_SIZE=3145728
MAX_VIDEO_SIZE=10485760

STORAGE_ORPHAN_WATCH=false


# Zoho Books import (SUPER_ADMIN). Self Client from api-console.zoho.com; scope ZohoBooks.contacts.READ,ZohoBooks.customerpayments.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_URL=https://www.zohoapis.com/books/v3
ZOHO_ACCESS_TOKEN=
# Zoho vendors list. true = only the Signage creditors (Zoho "Contact Code" below, about 577). false = every vendor in Zoho (about 8,111).
ZOHO_SIGNAGE_CREDITORS_ONLY=true
ZOHO_VENDOR_CONTACT_CODE=Creditors - Signage
# Quick start only (expires in ~1 hour). Prefer the refresh-token values above.

# Code request emails (Client Servicing): extra sender identities (";"-separated), recipient groups (","-separated), footer logo URL
MAIL_FROM_IDENTITIES=

# Reply mailbox (IMAP). The CRM reads the code out of replies to code / vendor request emails. Leave IMAP_HOST empty to turn it off.
# Gmail / Google Workspace: imap.gmail.com, port 993, and an App Password (not the normal password).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=reactdeveloper@adinn.co.in
IMAP_PASS=rcygczaqthxdcujk
IMAP_MAILBOX=INBOX
IMAP_SENT_MAILBOX=[Gmail]/Sent Mail
# Seconds between checks (0 = only the Check now button in Mail settings)
MAIL_REPLY_POLL_SECONDS=120
# Accounts mailbox(es) for the vendor registration request mail (comma separated)
VENDOR_REGISTRATION_RECIPIENTS=
# GST lookup (paid, per call): legal name, trade name, status, address, PAN of a GST number. Empty key = off.
GST_VERIFY_URL=https://gst.getbusiness.co.in/api/v1/verify
GST_VERIFY_KEY=gst_BVgohP7G0OtwkF6mc2OQxdWK7NZGYS97

CODE_REQUEST_CLIENT_RECIPIENTS=
CODE_REQUEST_PROJECT_RECIPIENTS=
MAIL_LOGO_URL=

# Smart planner: where the in-house team starts from when a project has no start point
DEFAULT_BASE_NAME=Madurai Office
DEFAULT_BASE_LAT=9.9252
DEFAULT_BASE_LNG=78.1198

# Reply reading rules (optional; the defaults match the business rules)
# Vendor ID = digits only, this many or more in a row (letters around it are dropped: AB12345 -> 12345)
VENDOR_ID_MIN_DIGITS=5
# Project code = this many or more digits in a row; EST codes are a separate pattern (EST + 6 digits)
PROJECT_CODE_MIN_DIGITS=8
PROJECT_CODE_EST_DIGITS=6
# Characters allowed between EST and its digits (all read as "-")
PROJECT_CODE_EST_SEPARATORS=-_/ 
# Extra project code formats: regex sources separated by |||  e.g. PRJ[-_/ ]?\d{4}[-_/ ]?\d{3,5}
PROJECT_CODE_EXTRA_PATTERNS=
