# LOCAL development example. Copy to .env.development.
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:51995,http://10.0.2.2:4000
COOKIE_SECURE=false

# Files go to disk: public/uploads/BD/Client_Details/<client>/<project>/... and public/uploads/Recce/<client>/<project>/Images/...
STORAGE_TYPE=local
LOCAL_UPLOAD_PATH=public/uploads
STORAGE_PREFIX=signage
MAX_FILE_SIZE=52428800
MAX_IMAGE_SIZE=3145728
MAX_VIDEO_SIZE=10485760

# Link target used inside notification emails (the web CRM address)
WEB_BASE_URL=http://localhost:3000
