# LOCAL development example. Copy to .env.development.
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:51995,http://10.0.2.2:4000
COOKIE_SECURE=false


# Files go to disk: public/uploads/BD/Client_Details/<client>/<project>/... and public/uploads/Recce/<client>/<project>/Images/...
STORAGE_TYPE=local
LOCAL_UPLOAD_PATH=public/uploads
STORAGE_PREFIX=signage
MAX_FILE_SIZE=52428800
MAX_IMAGE_SIZE=3145728
MAX_VIDEO_SIZE=10485760


# Link target used inside notification emails (the web CRM address)
WEB_BASE_URL=http://localhost:3000
# Map services for shop allocation (open services, no key). Leave as is, or point to your own server.
ROUTING_URL=https://router.project-osrm.org
GEOCODER_URL=https://nominatim.openstreetmap.org
MAPS_USER_AGENT=AdinnSignageRecceCRM/1.0 (ops@your-company.example)
# Optional: a Google Maps Platform key (Geocoding API + Routes API). Leave empty to use the open services above.
GOOGLE_MAPS_API_KEY=
GOOGLE_TRAVEL_MODE=TWO_WHEELER

# Read notifications are deleted after this many days (0 = keep forever); unread are never deleted
NOTIFICATION_READ_RETENTION_DAYS=7 # 7 days after auto delete the READ notifications only
NOTIFICATION_CLEANUP_INTERVAL_HOURS=6

# public-read = anyone with the file URL can open it; private = only signed links from the CRM
DO_SPACES_ACL=public-read

# Erase stored files that no project records (0 = off). Grace = never touch files newer than this many minutes
STORAGE_ORPHAN_CLEANUP_HOURS=1
STORAGE_ORPHAN_GRACE_MINUTES=1

# Clear leftovers within seconds when a project is deleted straight in MongoDB (needs Atlas / a replica set)
STORAGE_ORPHAN_WATCH=true
